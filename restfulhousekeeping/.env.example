MYSQL_DATABASE=restfulhousekeeping
MYSQL_USER=restfulhousekeeping
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password

# Local Docker Compose can load sample data for testing. Leave this false on
# an internet-facing deployment unless the demo accounts are intentional.
APP_BOOTSTRAP_ENABLED=true
